// ---------------------------------------------------------------------------
// Credit notes — customer credits and supplier credits
// ---------------------------------------------------------------------------

/// A credit against an invoice or a purchase that is being kept on file.
///
/// Distinct from a reversal: a reversal unwinds a document as though it never
/// happened, while a credit note is its own document that reduces what is owed
/// and leaves both papers in the history. A customer credit may also bring
/// coffee back into stock, in which case the cost of sale is reversed with it.
model CreditNote {
  id                 String            @id @default(cuid())
  companyId          String
  creditNoteNumber   String
  type               CreditNoteType
  creditDate         DateTime          @db.Date
  customerId         String?
  vendorId           String?
  /// The document being credited, when the credit relates to one.
  salesInvoiceId     String?
  purchaseContractId String?
  currency           String            @db.VarChar(3)
  rateToUsd          Decimal           @default(1) @db.Decimal(18, 8)
  rateLocalPerUsd    Decimal           @default(1) @db.Decimal(18, 8)
  subtotalAmount     Decimal           @default(0) @db.Decimal(18, 4)
  subtotalAmountUsd  Decimal           @default(0) @db.Decimal(18, 4)
  taxAmount          Decimal           @default(0) @db.Decimal(18, 4)
  taxAmountUsd       Decimal           @default(0) @db.Decimal(18, 4)
  /// Gross, including tax — what actually comes off the party's balance.
  totalAmount        Decimal           @default(0) @db.Decimal(18, 4)
  totalAmountUsd     Decimal           @default(0) @db.Decimal(18, 4)
  /// Cost of any stock returned to the warehouse, reversed out of COGS.
  costOfGoodsUsd     Decimal           @default(0) @db.Decimal(18, 4)
  reason             String
  reference          String?
  notes              String?
  status             TransactionStatus @default(DRAFT)
  postedAt           DateTime?
  postedById         String?
  reversedAt         DateTime?
  reversalReason     String?
  createdById        String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer         Customer?         @relation(fields: [customerId], references: [id])
  vendor           Vendor?           @relation(fields: [vendorId], references: [id])
  salesInvoice     SalesInvoice?     @relation(fields: [salesInvoiceId], references: [id])
  purchaseContract PurchaseContract? @relation(fields: [purchaseContractId], references: [id])
  createdBy        User              @relation("CreditNoteCreatedBy", fields: [createdById], references: [id])
  postedBy         User?             @relation("CreditNotePostedBy", fields: [postedById], references: [id])
  lines            CreditNoteLine[]
  journalLines     JournalLine[]

  @@unique([companyId, creditNoteNumber])
  @@index([companyId, status])
  @@index([companyId, type])
  @@index([companyId, customerId])
  @@index([companyId, vendorId])
  @@index([salesInvoiceId])
  @@map("credit_notes")
}

model CreditNoteLine {
  id           String  @id @default(cuid())
  creditNoteId String
  lineNumber   Int
  description  String
  /// Set when the credit brings coffee back into a warehouse.
  batchId      String?
  warehouseId  String?
  itemId       String?
  quantityKg   Decimal @default(0) @db.Decimal(18, 3)
  bags         Int     @default(0)
  unitPrice    Decimal @default(0) @db.Decimal(18, 8)
  lineTotal    Decimal @default(0) @db.Decimal(18, 4)
  lineTotalUsd Decimal @default(0) @db.Decimal(18, 4)
  costTotalUsd Decimal @default(0) @db.Decimal(18, 4)
  taxCodeId    String?
  taxRatePct   Decimal @default(0) @db.Decimal(9, 4)
  taxAmount    Decimal @default(0) @db.Decimal(18, 4)
  taxAmountUsd Decimal @default(0) @db.Decimal(18, 4)

  taxCode    TaxCode?    @relation(fields: [taxCodeId], references: [id])
  creditNote CreditNote  @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  batch      Batch?      @relation(fields: [batchId], references: [id])
  warehouse  Warehouse?  @relation(fields: [warehouseId], references: [id])
  item       CoffeeItem? @relation(fields: [itemId], references: [id])

  @@index([creditNoteId])
  @@index([batchId])
  @@map("credit_note_lines")
}

// ---------------------------------------------------------------------------
// Physical stock count
// ---------------------------------------------------------------------------

/// A count sheet for one warehouse: what the system thinks is there, what was
/// actually found, and the adjustment that reconciles the two.
model StockCount {
  id           String           @id @default(cuid())
  companyId    String
  countNumber  String
  countDate    DateTime         @db.Date
  warehouseId  String
  status       StockCountStatus @default(DRAFT)
  notes        String?
  countedById  String?
  approvedById String?
  postedAt     DateTime?
  createdById  String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse  Warehouse        @relation(fields: [warehouseId], references: [id])
  createdBy  User             @relation("StockCountCreatedBy", fields: [createdById], references: [id])
  countedBy  User?            @relation("StockCountCountedBy", fields: [countedById], references: [id])
  approvedBy User?            @relation("StockCountApprovedBy", fields: [approvedById], references: [id])
  lines      StockCountLine[]

  @@unique([companyId, countNumber])
  @@index([companyId, status])
  @@index([warehouseId])
  @@map("stock_counts")
}

model StockCountLine {
  id           String                 @id @default(cuid())
  stockCountId String
  batchId      String
  /// Snapshot at the moment the sheet was produced, so a later movement does
  /// not silently change what the counter was asked to verify.
  systemKg     Decimal                @db.Decimal(18, 3)
  countedKg    Decimal?               @db.Decimal(18, 3)
  differenceKg Decimal                @default(0) @db.Decimal(18, 3)
  reason       StockAdjustmentReason?
  notes        String?

  stockCount StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  batch      Batch      @relation(fields: [batchId], references: [id])

  @@unique([stockCountId, batchId])
  @@index([stockCountId])
  @@map("stock_count_lines")
}

// ---------------------------------------------------------------------------
// Bank reconciliation
// ---------------------------------------------------------------------------

/// One statement period for one account: the closing balance the bank states,
/// and which ledger lines have been ticked against it.
model BankReconciliation {
  id                String    @id @default(cuid())
  companyId         String
  cashBankAccountId String
  statementDate     DateTime  @db.Date
  statementBalance  Decimal   @db.Decimal(18, 4)
  /// Ledger balance at the statement date, captured when the work was done.
  bookBalance       Decimal   @default(0) @db.Decimal(18, 4)
  difference        Decimal   @default(0) @db.Decimal(18, 4)
  isComplete        Boolean   @default(false)
  completedAt       DateTime?
  notes             String?
  createdById       String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cashBankAccount CashBankAccount @relation(fields: [cashBankAccountId], references: [id])
  createdBy       User            @relation("ReconciliationCreatedBy", fields: [createdById], references: [id])
  lines           JournalLine[]

  @@unique([companyId, cashBankAccountId, statementDate])
  @@index([companyId, isComplete])
  @@map("bank_reconciliations")
}

// ---------------------------------------------------------------------------
// Backup history
// ---------------------------------------------------------------------------

/// A record of every backup attempt. A backup nobody can point at is not a
/// backup, so failures are kept as prominently as successes.
model BackupRun {
  id           String        @id @default(cuid())
  companyId    String?
  trigger      BackupTrigger
  status       BackupStatus  @default(IN_PROGRESS)
  startedAt    DateTime      @default(now())
  finishedAt   DateTime?
  sizeBytes    BigInt?
  location     String?
  checksum     String?
  errorMessage String?
  createdById  String?

  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("BackupCreatedBy", fields: [createdById], references: [id])

  @@index([status, startedAt])
  @@map("backup_runs")
}

model NumberSequence {
  id         String   @id @default(cuid())
  companyId  String
  docType    String
  year       Int
  prefix     String
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, docType, year])
  @@map("number_sequences")
}

model ExchangeRate {
  id            String   @id @default(cuid())
  companyId     String?
  quoteCurrency String   @db.VarChar(3)
  rate          Decimal  @db.Decimal(18, 8)
  effectiveDate DateTime @db.Date
  createdAt     DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, quoteCurrency, effectiveDate])
  @@index([quoteCurrency, effectiveDate])
  @@map("exchange_rates")
}

// ---------------------------------------------------------------------------
// Tax (VAT in the UAE, TVA in Morocco)
// ---------------------------------------------------------------------------

enum TaxAppliesTo {
  SALES
  PURCHASE
  BOTH
}

/// Why a supply carries the rate it does. A tax return has to separate a
/// zero-rated export from an exempt supply even though both charge nothing,
/// because they are reported on different lines and treated differently for
/// input-tax recovery.
enum TaxTreatment {
  STANDARD
  ZERO_RATED
  EXEMPT
  OUT_OF_SCOPE
  REVERSE_CHARGE
}

model TaxCode {
  id        String       @id @default(cuid())
  companyId String
  code      String       @db.VarChar(12)
  name      String
  ratePct   Decimal      @default(0) @db.Decimal(9, 4)
  treatment TaxTreatment @default(STANDARD)
  appliesTo TaxAppliesTo @default(BOTH)
  /// Chosen automatically on new lines. At most one per direction.
  isDefault Boolean      @default(false)
  isSystem  Boolean      @default(false)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  company           Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesInvoiceLines SalesInvoiceLine[]
  purchaseLines     PurchaseContractLine[]
  creditNoteLines   CreditNoteLine[]
  expenses          Expense[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@map("tax_codes")
}

enum TaxReturnStatus {
  DRAFT
  FILED
}

/// A filed period. Filing freezes the figures as submitted so a later
/// correction is visible as a difference rather than silently rewriting
/// history the authority has already seen.
model TaxReturn {
  id             String          @id @default(cuid())
  companyId      String
  periodStart    DateTime        @db.Date
  periodEnd      DateTime        @db.Date
  status         TaxReturnStatus @default(DRAFT)
  /// Every figure below is in the company's local currency.
  outputTax      Decimal         @default(0) @db.Decimal(18, 4)
  inputTax       Decimal         @default(0) @db.Decimal(18, 4)
  netPayable     Decimal         @default(0) @db.Decimal(18, 4)
  standardSales  Decimal         @default(0) @db.Decimal(18, 4)
  zeroRatedSales Decimal         @default(0) @db.Decimal(18, 4)
  exemptSales    Decimal         @default(0) @db.Decimal(18, 4)
  purchases      Decimal         @default(0) @db.Decimal(18, 4)
  reference      String?
  notes          String?
  filedAt        DateTime?
  filedById      String?
  createdById    String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User    @relation("TaxReturnCreatedBy", fields: [createdById], references: [id])
  filedBy   User?   @relation("TaxReturnFiledBy", fields: [filedById], references: [id])

  @@unique([companyId, periodStart, periodEnd])
  @@index([companyId, status])
  @@map("tax_returns")
}

/// What an expense is for.
///
/// The client's own division: money spent on getting one consignment to the
/// warehouse and sold, against money spent running the business. A staff
/// dinner and a clearing agent's invoice are both cash out of the same petty
/// cash box, and they must not land in the same place.
enum ExpenseKind {
  SHIPMENT
  GENERAL
}

/// A port the business actually ships through.
///
/// The shipment keeps its own free-text port fields rather than pointing here:
/// a bill of lading says what it says, and a document has to record that even
/// when it disagrees with the master list. This exists so the entry forms can
/// offer a list instead of a blank box — the same port typed four ways is how
/// a shipment register stops being groupable.
model Port {
  id        String       @id @default(cuid())
  companyId String
  /// UN/LOCODE where there is one, e.g. AEJEA. Short and unique per company.
  code      String       @db.VarChar(12)
  name      String
  country   String?
  notes     String?
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([companyId, status])
  @@map("ports")
}
