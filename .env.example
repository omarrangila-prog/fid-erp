# ---------------------------------------------------------------------------
# FID Trading IBMS — environment variables
# Copy to `.env` and fill in real values. Never commit a populated .env file.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# The connection the application uses at runtime.
#
# Local PostgreSQL:
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/fid_trading?schema=public"
#
# Supabase — Project → Connect. Use the **Session pooler** string (port 5432)
# for a long-running server, or the **Transaction pooler** (port 6543) for
# serverless. Both need TLS, so keep `sslmode=require`:
# DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Direct connection, used only by `prisma migrate` and `prisma db push`.
# Migrations take advisory locks and set session state, which the transaction
# pooler cannot do — so point this at the direct connection or session pooler.
# Leave it unset when DATABASE_URL is already a direct connection.
# DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECTREF.supabase.co:5432/postgres?sslmode=require"

# Maximum connections in the application's pool. Keep it small behind a pooler:
# 10 is fine for one server, 1–3 per instance for serverless.
DATABASE_POOL_MAX="10"

# Optional root certificate for a provider that uses its own CA. Supabase
# offers one to download; it is not needed for the pooler hostnames, which
# verify against the public roots Node already trusts.
# DATABASE_SSL_CA="/absolute/path/to/prod-ca.crt"
#
# TLS is controlled by `sslmode` in the URL above:
#   sslmode=disable    plain TCP — local development only
#   sslmode=no-verify  encrypted, certificate not checked (self-signed CA)
#   sslmode=require    encrypted, certificate chain verified  ← use this

# Separate database used by the integration test suite. It is TRUNCATED between
# test runs, so it must never point at development or production data — and in
# particular never at your Supabase project.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/fid_trading_test?schema=public"

# --- Sessions --------------------------------------------------------------
# Name of the HTTP-only session cookie.
SESSION_COOKIE_NAME="fid_session"

# Session lifetime in hours. Sessions are stored server-side and revocable.
SESSION_TTL_HOURS="12"

# --- First administrator ---------------------------------------------------
# Bootstrap credentials for the first Super Admin, consumed by `npm run db:init`.
# Use a strong password and change it immediately after the first sign-in.
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_NAME="System Administrator"
INITIAL_ADMIN_PASSWORD="change-me-to-a-strong-password"

# --- Runtime ---------------------------------------------------------------
# "development" | "test" | "production"
NODE_ENV="development"
