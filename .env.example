# ---------------------------------------------------------------------------
# FID Trading IBMS — environment variables
# Copy to `.env` and fill in real values. Never commit a populated .env file.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# The connection the application uses at runtime.
#
# Local PostgreSQL:
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/fid_trading?schema=public"
#
# Supabase — Project → Connect. Use the **Session pooler** (port 5432) for a
# long-running server, or the **Transaction pooler** (6543) for serverless. The
# username is postgres.<project-ref>, and a password containing @ # / ? must be
# percent-encoded (@ becomes %40). Do not use the direct db.<ref>.supabase.co
# host: it is IPv6-only unless you have the IPv4 add-on.
# DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Used only by `prisma migrate` and `prisma db push`. Migrations take advisory
# locks and set session state, which a transaction pooler cannot carry — point
# this at the session pooler (5432) or a direct connection, never at 6543.
# Prisma's schema engine opens its own connection and ignores DATABASE_SSL_CA,
# so a custom CA has to be named here as `sslcert`.
# DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require&sslcert=certs/supabase-prod-ca-2021.crt"

# Maximum connections in the application's pool. Keep it small behind a pooler:
# 10 is fine for one server, 1–3 per instance for serverless.
DATABASE_POOL_MAX="10"

# Ceiling on a posting transaction, in milliseconds. The default suits a
# database on the same network. Raise it only if the database is far away —
# and prefer moving the database closer.
# DATABASE_TRANSACTION_TIMEOUT_MS="20000"

# Root certificate for a provider that uses its own CA. Supabase's poolers do:
# without this, Node fails with "self-signed certificate in certificate chain".
# The certificate ships with the repository, so this path is all you need.
# DATABASE_SSL_CA="certs/supabase-prod-ca-2021.crt"
#
# TLS is controlled by `sslmode` in the URL above:
#   sslmode=disable    plain TCP — local development only
#   sslmode=no-verify  encrypted, certificate not checked (self-signed CA)
#   sslmode=require    encrypted, certificate chain verified  ← use this

# Separate database used by the integration test suite. It is TRUNCATED between
# test runs, so it must never point at development or production data — and in
# particular never at your Supabase project.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/fid_trading_test?schema=public"

# --- Sessions --------------------------------------------------------------
# Name of the HTTP-only session cookie.
SESSION_COOKIE_NAME="fid_session"

# Session lifetime in hours. Sessions are stored server-side and revocable.
SESSION_TTL_HOURS="12"

# --- First administrator ---------------------------------------------------
# Bootstrap credentials for the first Super Admin, consumed by `npm run db:init`.
# Use a strong password and change it immediately after the first sign-in.
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_NAME="System Administrator"
INITIAL_ADMIN_PASSWORD="change-me-to-a-strong-password"

# --- Runtime ---------------------------------------------------------------
# "development" | "test" | "production"
NODE_ENV="development"
